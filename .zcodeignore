# IndexTTS 配音工具产物(不入库;入库的是 public/audio/radio/*.mp3 与 manifest)
/download/tts/*
!/download/tts/voice-plan.json
!/download/tts/voices.json

# UI 验收截图(scripts/ui-shot.mjs 产物,本地查验用,不入库)
/.shots/

